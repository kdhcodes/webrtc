# gn args for upstream libwebrtc M150, macOS arm64 (scripts/build-libwebrtc.sh).
# The system libc++ (binding.gyp compiles against it too), RTTI and exported
# symbols. No H264/H265: VP8, VP9 and
# AV1 (libaom encode, dav1d decode) only.
is_debug = false
is_component_build = false
target_os = "mac"
target_cpu = "arm64"
mac_deployment_target = "10.15"
mac_min_system_version = "10.15"
enable_dsyms = false
enable_stripping = true
treat_warnings_as_errors = false

use_custom_libcxx = false
use_rtti = true
use_lld = false
use_clang_modules = false
clang_use_chrome_plugins = false

rtc_include_tests = false
rtc_build_examples = false
rtc_build_tools = false
rtc_enable_protobuf = false
rtc_enable_symbol_export = true
rtc_enable_objc_symbol_export = false
rtc_include_internal_audio_device = true

rtc_use_h264 = false
rtc_use_h265 = false
proprietary_codecs = false
rtc_libvpx_build_vp9 = true
enable_libaom = true
rtc_include_dav1d_in_internal_decoder_factory = true
