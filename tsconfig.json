{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "lib",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["lib/**/*.test.ts", "lib/internal/testing/**"]
}
